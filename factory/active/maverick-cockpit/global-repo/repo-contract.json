{
  "name": "maverick-global-repo-package",
  "version": 1,
  "created_at": "2026-06-14T16:35:13-04:00",
  "purpose": "Prepare Maverick Cockpit as a reusable/global repository package without pushing or creating an external repo.",
  "suggested_repo_name": "maverick-cockpit",
  "suggested_visibility": "private",
  "publish_gate": "github_publish",
  "export_gate": "icloud_artifact_export",
  "package_manifest": "factory/active/maverick-cockpit/global-repo/package-manifest.json",
  "assembly_manifest": "factory/active/maverick-cockpit/global-repo/assembly-manifest.json",
  "package_dir": "factory/active/maverick-cockpit/global-repo/package",
  "standalone_readme": "factory/active/maverick-cockpit/global-repo/README.md",
  "source_manifest": "factory/active/maverick-cockpit/write-gates/export-manifest.json",
  "target_discovery": "factory/active/maverick-cockpit/target-discovery.json",
  "confirmation_request": "factory/active/maverick-cockpit/confirmation-request.md",
  "publish_status": "prepared_local_only",
  "external_mutation_allowed": false,
  "repo_layout": [
    {
      "target": "README.md",
      "source": "factory/active/maverick-cockpit/global-repo/README.md",
      "role": "entrypoint"
    },
    {
      "target": "docs/",
      "source": "docs/maverick-*.md",
      "role": "operating documentation"
    },
    {
      "target": "cockpit/",
      "source": "factory/active/maverick-cockpit/dashboard/",
      "role": "static dashboard, PWA manifest, service worker, and device-safe data"
    },
    {
      "target": "netlify.toml",
      "source": "factory/active/maverick-cockpit/global-repo/netlify.toml",
      "role": "always-on static HTTPS deployment hint"
    },
    {
      "target": "contracts/",
      "source": "factory/active/maverick-cockpit/*.json and nested contract files",
      "role": "machine-readable operating state"
    },
    {
      "target": "CONFIRMATION_REQUEST.md",
      "source": "factory/active/maverick-cockpit/confirmation-request.md",
      "role": "human confirmation gate"
    },
    {
      "target": "scripts/",
      "source": "factory/maverick_*.py and factory/validate_maverick.py",
      "role": "local builders and validators"
    }
  ],
  "required_confirmation_before_publish": [
    "MAVERICK-CONFIRM github_publish <action_id>",
    "confirmed repo owner/name or create-new-repo instruction",
    "confirmed branch name",
    "confirmed publish mode"
  ]
}
