{
  "name": "maverick-write-gates",
  "version": 1,
  "created_at": "2026-06-14T16:30:35-04:00",
  "purpose": "Prevent external Maverick mutations unless the exact gate and action are explicitly confirmed.",
  "audit_log": "factory/active/maverick-cockpit/write-gates/audit-log.ndjson",
  "export_manifest": "factory/active/maverick-cockpit/write-gates/export-manifest.json",
  "confirmation": {
    "token_shape": "MAVERICK-CONFIRM <gate_id> <action_id>",
    "default_action_id": "phase6-dry-run",
    "expires": "per-action; tokens are not reusable across gate ids or action ids"
  },
  "gates": [
    {
      "id": "notion_status_update",
      "system": "notion",
      "operation": "update case/task status",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": false,
      "notes": "Blocked until live Notion row update method is confirmed."
    },
    {
      "id": "gmail_send",
      "system": "gmail",
      "operation": "send or schedule email",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": false,
      "notes": "Drafting may become local or connector-backed later; sending always requires per-message confirmation."
    },
    {
      "id": "google_calendar_update",
      "system": "google_calendar",
      "operation": "create or update calendar event",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": false,
      "notes": "Blocked until calendar source-of-truth and event ownership are mapped."
    },
    {
      "id": "icloud_artifact_export",
      "system": "icloud_drive",
      "operation": "copy Maverick artifacts to iCloud Drive destination",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": true,
      "notes": "Enabled only for tokened exports to the user-provided local iCloud Drive MAVERICK folder."
    },
    {
      "id": "github_publish",
      "system": "github",
      "operation": "push branch, create repo, or create pull request",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": false,
      "notes": "GitHub remains the canonical version surface, but publish actions need an explicit repo/branch confirmation."
    },
    {
      "id": "slack_write",
      "system": "slack",
      "operation": "send a message through the Maverick Slack app",
      "policy": "confirmation_required",
      "external_mutation": true,
      "enabled": false,
      "notes": "The legacy Slack watch remains read-only. The Maverick Slack app A0BALRB6CNQ can become an outbound communication lane after channel/DM target, secret storage, and per-message confirmation are settled."
    }
  ],
  "local_exports": [
