#!/usr/bin/env bash
# Federation Protocol — pre-push enforcement. See org/FEDERATION_SOP.md.
#   F3: a contributing instance must not push to the protected branch (branch + PR instead).
#   F4: no force / non-fast-forward push over the protected branch (never overwrite canon).
# Git feeds stdin lines: <local_ref> <local_oid> <remote_ref> <remote_oid>
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
. "$DIR/federation-lib.sh"

[ "${FEDERATION_OVERRIDE:-0}" = "1" ] && exit 0

protected="$(fed_protected_branch)"
zero="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -z "${remote_ref:-}" ] && continue
  [ "$remote_ref" != "refs/heads/$protected" ] && continue

  # F3/F4: contributing instances never push to the protected branch.
  if ! fed_is_manager; then
    fed_red "✗ FEDERATION F3/F4: contributing instance ($(fed_hostname)) may not push to '$protected'."
    fed_red "  Push your branch and open a PR for the Manager of record to merge."
    status=1
    continue
  fi

  # F4: even the Manager may not force / non-fast-forward over the protected branch.
  if [ "$remote_oid" != "$zero" ]; then
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
      fed_red "✗ FEDERATION F4: refusing non-fast-forward (force) push to '$protected'."
      fed_red "  origin/$protected would be overwritten/regressed. Reconcile, don't force."
      status=1
    fi
  fi
done

if [ "$status" -ne 0 ]; then
  fed_red "  Override (Edwin / emergency):  FEDERATION_OVERRIDE=1 git push …   or   git push --no-verify"
fi
exit "$status"
